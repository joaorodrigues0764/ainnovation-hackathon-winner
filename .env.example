# Copiar para .env (na raiz do repo) e preencher (o .env nunca vai para o git)
OPENAI_API_KEY=COLA_AQUI_OPENAI_API_KEY
OPENAI_MODEL=gpt-4o-mini
# opcional: só para modelos de raciocínio (ex.: none, low); vazio = não enviar
OPENAI_REASONING_EFFORT=
# opcional: modelo de embeddings do RAG
EMBED_MODEL=intfloat/multilingual-e5-small
# opcional: API (0 = só BM25, arranque rápido sem descarregar o modelo de embeddings)
USE_EMBEDDINGS=1
CORS_ORIGINS=http://localhost:3000
DEMO_OFFLINE=0
